#include<iostream>
using namespace std;

class Queue {
	public :
		virtual void enqueue(int value)=0;
		virtual void dequeue()=0;
		virtual void peek()=0;
		virtual void isEmpty()=0;
		virtual void isFull()=0;
		virtual void display()=0;
};

#define MAX 5

class ArrayQueue: public Queue {
	private:
		int arr[MAX];
		int front;
		int rear;
		
	public:
		ArrayQueue() {
			front=-1;
			rear=-1;
		}
		
	void enqueue(int vlue) override{
	if(rear==MAX-1){
		cout<<"Queue overflow"<<endl;
	} else {
		if(front==-1)
		front = 0;
		arr[++rear]=value;
	 }
	}
	
	void dequeue() override {
		if(isEmpty()) {
			cout<<"Queue underflow"<<endl;
		} else {
			front++;
		}
	}
	
	int peek() override {
		if(isEmpty()) {
			cout<<"queue is empty"<<endl;
			return -1;
		}
		return arr[front];
	}
	
	bool isEmpty() override {
	  return (front==-1||front>rear); 
	}
	
	bool isFull() override {
		return (rear == MAX -1);
	}
	
	void display() override{
		 if(isEmpty()) {
		 	cout<<"queue is empty"<<endl;
		 } else {
		 	for(int i=front;i<rear;i++)
		 	{
		 		cout<<arr[i]<<" ";
			 }
			 cout<<endl;
		 }
	}
};

int main() {
	ArrayQueue q;
	q.enqueue(10);
	q.enqueue(16);
	q.enqueue(67);
	q.enqueue(90);
	
	q.display();
	cout<<"front :"<<q.peek()<<endl;
	q.dequeue();
	q.display();
	
	return 0;
}
